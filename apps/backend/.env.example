# Supabase Postgres connection string (Project Settings -> Database -> Connection string -> URI).
# Use the "Session pooler" (port 5432) or "Transaction pooler" URI, then swap the
# driver prefix from postgresql:// to postgresql+psycopg:// as shown below.
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Project Settings -> API -> Project URL
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co

# Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
