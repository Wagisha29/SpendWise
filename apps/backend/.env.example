# Supabase Postgres connection string. Use the "Session pooler" URI from
# Project Settings -> Database -> Connection string -> Session pooler (NOT "Direct
# connection" - that host is IPv6-only and unreachable from most cloud hosts like
# Render/Vercel, which lack outbound IPv6). Session pooler is IPv4-compatible and
# behaves like a normal connection (safe for SQLAlchemy's default pooling), unlike
# the transaction pooler on port 6543. Swap the driver prefix from postgresql:// to
# postgresql+psycopg:// as shown below. Note the username includes the project ref.
DATABASE_URL=postgresql+psycopg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Project Settings -> API -> Project URL
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co

# Legacy JWT secret (Project Settings -> API -> JWT Settings). Used as a fallback -
# newer Supabase projects sign tokens with an asymmetric key verified via JWKS instead,
# which app/core/auth.py tries first automatically.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Comma-separated list of allowed frontend origins (CORS). Add your deployed
# frontend URL(s) here once you know them, e.g.:
# ALLOWED_ORIGINS=http://localhost:5173,https://spendwise.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
